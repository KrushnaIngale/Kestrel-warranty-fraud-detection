# .gitignore — Kestrel Warranty Fraud Detection

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs and caches
*.log
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Large files (but NOT predictions.csv)
*.pkl
# models/*.joblib  # Keep model artifacts for reproducibility

# Streamlit
.streamlit/

# Environment files with secrets
.env
*.env.local

# NOTE: predictions.csv is intentionally NOT ignored — it must be committed
